    "seo:generate": "node scripts/generate-sitemap.cjs && node scripts/generate-yandex-feed.cjs"
  },
  "dependencies": {
    "basic-ftp": "^5.1.0",
    "front-matter": "^4.0.2",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^2.0.5",
    "react-input-mask": "^2.0.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react-input-mask": "^3.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.61.1",
    "postcss": "^8.4.38",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.8.2",
    "vite": "^6.4.1"
  }
