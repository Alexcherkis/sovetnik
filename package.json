{
  "name": "sovetnik-expert-buro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clone": "TAILWIND_CONFIG=tailwind.config.clone.js vite --mode clone --port 3002",
    "build": "vite build",
    "build:clone": "TAILWIND_CONFIG=tailwind.config.clone.js vite build --mode clone",
    "postbuild": "node scripts/generate-sitemap.cjs && node scripts/prerender.mjs && node scripts/generate-yandex-feed.cjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
