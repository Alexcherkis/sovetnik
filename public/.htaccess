# Set environment variables for PHP send-form.php script
SetEnv TELEGRAM_BOT_TOKEN "8500064360:AAEcfNab5xs7eo5iX5KRBDzttAPHBvvjueY"
SetEnv TELEGRAM_CHAT_ID "-5290829707"
SetEnv LEADS_EMAIL_TO "kireev-rinat@list.ru"

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (Correct check for Nginx proxies)
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Force Non-WWW
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # 3. Fallback to index.html for React Routes
  RewriteRule ^index\.html$ - [L]
  
  # Exclude physical files and common assets from index.html fallback
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Only fallback to index.html if it doesn't look like a static file (no dot in last segment)
  RewriteCond %{REQUEST_URI} ![a-zA-Z0-9]+\.[a-zA-Z0-9]{2,4}$
  RewriteRule . /index.html [L]
</IfModule>