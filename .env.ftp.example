# FTP credentials для деплоя на хостинг Rec Group
# Скопируйте этот файл в .env.ftp и заполните свои данные
# .env.ftp добавлен в .gitignore — не попадёт в репозиторий

FTP_HOST=ftp.ваш-хостинг.ru
FTP_USER=ваш-логин
FTP_PASSWORD=ваш-пароль
FTP_REMOTE_DIR=/public_html

# Для SFTP/FTPS включите secure (по умолчанию false — обычный FTP)
# FTP_SECURE=true

# Очищать ли удалённую папку перед загрузкой (осторожно!)
# FTP_CLEAR_REMOTE_DIR=false
